# Copy this file to 04_orchestration/.env and fill in the values.
# The real .env is in .gitignore. Never commit it.

# Airflow container user. Keep 50000 on Windows and macOS.
AIRFLOW_UID=50000

# Encryption key for Airflow connections. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Databricks workspace. Used by the CDC task and by dbt.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_JOB_ID=

# Source PostgreSQL database. Used by 01_source/load_data.py.
POSTGRES_CONN_STRING=
